# Copy this file to .env before starting the cluster:
#   cp .env.example .env   (bash)
#   Copy-Item .env.example .env   (PowerShell)

# Cluster identity used by Hadoop core-site.xml (fs.defaultFS)
CLUSTER_NAME=retailstream-hdfs-lab

# HDFS replication factor (must be <= number of live DataNodes).
# Lab has 2 DataNodes, so 2 is the max meaningful value for a demo.
HDFS_REPLICATION=2

# Host ports exposed for the Web UIs / RPC. Change these if they clash with
# something else already running on your machine (see README "loi thuong gap").
NAMENODE_HTTP_PORT=9870
NAMENODE_RPC_PORT=9000
DATANODE1_HTTP_PORT=9864
DATANODE2_HTTP_PORT=9865

# YARN (ResourceManager + NodeManager + HistoryServer) - them cho Buoi 7
# (MapReduce chay tren YARN that thay vi LocalJobRunner).
RESOURCEMANAGER_HTTP_PORT=8088
NODEMANAGER1_HTTP_PORT=8042
HISTORYSERVER_HTTP_PORT=8188
