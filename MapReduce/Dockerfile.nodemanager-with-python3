# Image NodeManager co san python3 (khong can cai lai moi lan restart container).
#
# Van de: mapper.py/reducer.py (Hadoop Streaming) khong chay tren NameNode ma
# chay tren NodeManager (noi YARN container thuc thi task that). Ban dau chi
# namenode duoc build voi python3 (xem Dockerfile.namenode-with-python3), khi
# chuyen sang YARN that (khong con LocalJobRunner) thi NodeManager can python3
# de mapper/reducer chay duoc — day la fix tiep theo cua cung ISSUE-02.
#
# Cung logic: apt tro sang archive.debian.org (Debian 9 "stretch" da EOL).
FROM bde2020/hadoop-nodemanager:2.0.0-hadoop3.2.1-java8

RUN printf '%s\n%s\n' \
      'deb http://archive.debian.org/debian stretch main' \
      'deb http://archive.debian.org/debian-security stretch/updates main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
